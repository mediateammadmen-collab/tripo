# Copy this file to ".env.local" and fill it in. Never share or upload .env.local.

# --- Server only (secret) ---
# Which AI answers chat, city guides and receipts: gemini (default, cheaper) or openai.
# Only the chosen one is used. Live voice (OpenAI Realtime) only runs with openai;
# on gemini the Talk button uses the browser's free voice instead.
AI_PROVIDER=gemini
# Google Gemini key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: Gemini models (main, and backup if the main one is busy)
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# OpenAI — only used when AI_PROVIDER=openai. (CHATGPT_API_KEY also works as the name.)
OPENAI_API_KEY=
# Optional: OpenAI models
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin
# Optional: model used if the main one is busy
OPENAI_BACKUP_MODEL=gpt-4.1-mini

# --- Public settings (shown in the browser, not secret) ---
# Your live address once deployed, e.g. https://tripo.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number with country code, digits only, e.g. 8801712345678
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=
# Affiliate IDs (optional)
NEXT_PUBLIC_BOOKING_AID=
NEXT_PUBLIC_TRIP_ALLIANCE_ID=
NEXT_PUBLIC_TRIP_SID=

# --- Supabase (accounts + database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret: full database access. Server only — never expose or share.
SUPABASE_SECRET_KEY=
